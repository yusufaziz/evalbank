generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default("")
  name        String
  modelFY     Int
  modelSeries String
  modelName   String
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  settings    Setting[]
  evaluations Evaluation[]
  attachments Attachment[]
}

model Testcase {
  id          String       @id @default("")
  name        String
  group       String        @default("Common")
  procedures  String
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  checkitems  Checkitem[]
  attachments Attachment[]
  evaluations      Evaluation[]
}

model Checkitem {
  id               String       @id @default("")
  module           String
  expectedTarget   String
  settings        Setting[]
  testcaseId       String?
  testcase         Testcase?    @relation(fields: [testcaseId], references: [id])
  author           String?
  modifier         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  evaluations      Evaluation[]
  attachments      Attachment[]
}

model Setting {
  id          String       @id @default("")
  name        String
  value       String
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  checkitems  Checkitem[]
  evaluatons  Evaluation[]
  projects    Project[]
  attachments Attachment[]
  requiring  Setting[] @relation("requireSettings")
  requiredBy  Setting[] @relation("requireSettings")
}

model Evaluation {
  id          String       @id @default("")
  judgement   Int
  remarks     String?
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  testcaseId String?
  testcase   Testcase?   @relation(fields: [testcaseId], references: [id])
  checkitemId String?
  checkitem   Checkitem?   @relation(fields: [checkitemId], references: [id])
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  settings    Setting[]
  attachments Attachment[]
}

model Attachment {
  id          String       @id @default("")
  filename    String
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  settings    Setting[]
  evaluations Evaluation[]
  checkitems  Checkitem[]
  testcases   Testcase[]
  projects    Project[]
}

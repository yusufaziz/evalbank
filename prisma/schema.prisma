generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Represents a project in the system.
model Project {
  id             String       @id @default("")
  name           String
  modelFY        Int
  modelSeries    String
  modelName      String
  redmineProject String?
  author         String?
  modifier       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  settings       Setting[]    @relation("ProjectSettings")
  evaluations    Evaluation[] @relation("ProjectEvaluations")
  attachments    Attachment[] @relation("ProjectAttachments")
}

/// Represents a test case in the system.
model Testcase {
  id           String       @id @default("")
  name         String
  group        String       @default("Common")
  procedures   String
  redmineTitle String?
  author       String?
  modifier     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  checkitems   Checkitem[]    @relation("TestcaseCheckitems")
  attachments  Attachment[]   @relation("TestcaseAttachments")
  evaluations  Evaluation[]   @relation("TestcaseEvaluations")
}

/// Represents a check item in the system.
model Checkitem {
  id             String       @id @default("")
  module         String
  expectedTarget String
  testcaseId     String?
  author         String?
  modifier       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  testcase       Testcase?    @relation("TestcaseCheckitems", fields: [testcaseId], references: [id])
  settings       Setting[]    @relation("CheckitemSettings")
  evaluations    Evaluation[] @relation("CheckitemEvaluations")
  attachments    Attachment[] @relation("CheckitemAttachments")
}

/// Represents a setting in the system.
model Setting {
  id          String       @id @default("")
  name        String
  value       String
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  checkitems  Checkitem[]    @relation("CheckitemSettings")
  evaluatons  Evaluation[]   @relation("EvaluationSettings")
  projects    Project[]      @relation("ProjectSettings")
  attachments Attachment[]   @relation("SettingAttachments")

  // Self-referential relations
  requiring   Setting[]      @relation("RequiredBySettings")
  requiredBy  Setting[]      @relation("RequiredBySettings")
}

/// Represents an evaluation in the system.
model Evaluation {
  id          String       @id @default("")
  judgement   Int
  redmineId   String?
  remarks     String?
  projectId   String?
  testcaseId  String?
  checkitemId String?
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  project     Project?      @relation("ProjectEvaluations", fields: [projectId], references: [id])
  testcase    Testcase?     @relation("TestcaseEvaluations", fields: [testcaseId], references: [id])
  checkitem   Checkitem?    @relation("CheckitemEvaluations", fields: [checkitemId], references: [id])
  settings    Setting[]     @relation("EvaluationSettings")
  attachments Attachment[]  @relation("EvaluationAttachments")
}

/// Represents an attachment in the system.
model Attachment {
  id          String       @id @default("")
  filename    String
  author      String?
  modifier    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  settings    Setting[]     @relation("SettingAttachments")
  evaluations Evaluation[]  @relation("EvaluationAttachments")
  checkitems  Checkitem[]   @relation("CheckitemAttachments")
  testcases   Testcase[]    @relation("TestcaseAttachments")
  projects    Project[]     @relation("ProjectAttachments")
}
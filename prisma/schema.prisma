generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(uuid())
  name        String
  modelFY     Int
  modelSeries String
  modelName   String
  author      String?
  modifier    String?
  constrains String?
  evaluations Evaluation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Testcase {
  id         String      @id @default(uuid())
  name       String
  procedures String
  checkItems Checkitem[]
  author     String?
  modifier   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Checkitem {
  id             String       @id @default(uuid())
  module         String
  expectedTarget String
  settingsNames  String
  testCaseId     String?
  testcase       Testcase?    @relation(fields: [testCaseId], references: [id])
  evaluations    Evaluation[]
  author         String?
  modifier       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Setting {
  id         String       @id @default(uuid())
  name       String
  value      String
  constrains String?
  author     String?
  modifier   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  evaluatons Evaluation[]
}

model Evaluation {
  id         String      @id @default(uuid())
  judgement  Int
  remarks    String?
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id])
  checkitems Checkitem[]
  settings   Setting[]
  author     String?
  modifier   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

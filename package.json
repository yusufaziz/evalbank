{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf",
  "scripts": {
    "clean": "nuxi cleanup",
    "clean:node": "rmdir /s /q node_modules",
    "clean:all:install": "pnpm clean:all && pnpm install",
    "build": "nuxi build --dotenv .env",
    "dev": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "seed": "esno prisma/seed.ts",
    "db:init:seed": "prisma migrate dev --name init && pnpm seed",
    "lint": "eslint .",
    "format": "prettier . --write --list-different",
    "lint:fix": "eslint . --fix",
    "lint:fix:format": "pnpm format && pnpm lint:fix",
    "typecheck": "vue-tsc --noEmit",
    "start": "dotenv -e .env -- node .output/server/index.mjs",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "prisma:generate": "pnpm prisma generate",
    "deploy:latest": "git reset --hard HEAD && git pull && pnpm install && pm2 stop testpoint & pnpm clean && pnpm build && pnpm start:pm2",
    "deploy:release": "git checkout release && pnpm deploy:latest"
  },
  "dependencies": {
    "@antfu/eslint-config": "^3.14.0",
    "@faker-js/faker": "^9.3.0",
    "@internationalized/date": "^3.7.0",
    "@internationalized/number": "^3.6.0",
    "@morev/vue-transitions": "^3.0.5",
    "@nuxt/fonts": "^0.10.3",
    "@nuxt/icon": "^1.10.3",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "0.9.0",
    "@prisma/client": "^6.2.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/vue-table": "^8.20.5",
    "@types/string-similarity": "^4.0.2",
    "@unovis/ts": "^1.5.0",
    "@unovis/vue": "^1.5.0",
    "@vee-validate/nuxt": "^4.15.0",
    "@vee-validate/zod": "^4.15.0",
    "@vueuse/nuxt": "^12.4.0",
    "consola": "^3.4.0",
    "eslint-plugin-prettier-vue": "^5.0.0",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.9",
    "nuxt": "^3.15.1",
    "nuxt-seo-utils": "^6.0.8",
    "pinia": "^2.3.0",
    "prisma": "^6.2.1",
    "puppeteer": "^24.2.0",
    "radix-vue": "^1.9.12",
    "string-similarity": "^4.0.4",
    "tailwind-variants": "^0.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.5",
    "vaul-vue": "^0.2.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-sonner": "^1.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@iconify-json/lucide": "^1.2.22",
    "@nuxt/eslint": "^0.7.5",
    "@vueuse/core": "^12.4.0",
    "babel-eslint": "^10.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-format": "^1.0.1",
    "esno": "^4.8.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sass-embedded": "^1.83.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "ui-thing": "^0.1.50",
    "vue-tsc": "^2.2.0"
  }
}
